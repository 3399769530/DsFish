		padding-left: 24px;
		padding-right: 24px;
	}

	.hint {
		font-size: 12px;
		line-height: 19px;
		color: #8A8375;
		margin-top: 14px;
	}

	.link {
		font-size: 11.5px;
		color: #B4553C;
		margin-top: 8px;
	}

	.area {
		width: 100%;
		height: 220px;
		margin-top: 12px;
		padding: 12px;
		background-color: #EFE7D8;
		border-radius: 4px;
		font-family: monospace;
		font-size: 12px;
		color: #1C1A16;
	}

