<template>
	<view class="page">

		<view class="nav" :style="'padding-top:' + headPad + 'px'">
			<view class="back" @click="goBack">
				<text class="back-t">←</text>
			</view>
			<text class="title">导入 AI 生成的角色</text>
		</view>
		<view class="rule"></view>
		<!-- 生成器 ↔ 导入页互相连通 -->

		<scroll-view class="body" scroll-y="true">
			<view class="wrap">
				<text class="hint">把外部模型返回的 JSON 原样粘进来（带 ``` 围栏或前后废话都能自动修）。解析成功后先给你看摘要，确认再存成角色卡。</text>
				<text class="link" @click="onGoGen">还没提示词？去「让 AI 写角色卡」生成</text>

				<textarea class="area" :value="text" :maxlength="-1" placeholder="在这里长按 → 粘贴 JSON…"
					placeholder-style="color:#B9B1A0" @input="onInput"></textarea>
				<view class="meta-row">
					<text class="meta">{{ text.length }} 字符</text>
				</view>

				<view class="savebtn" :style="text.trim().length == 0 ? 'background-color:#C9BFAC' : 'background-color:#1C1A16'" @click="onParse">
					<text class="savebtn-t">解析</text>
				</view>

				<!-- 失败：卡在哪一步 + 原文片段 -->
				<view v-if="errText.length > 0" class="box box-err">
					<text class="box-t">导入失败</text>
					<text class="box-s">{{ errText }}</text>
					<text v-if="errSnip.length > 0" class="box-snip">{{ errSnip }}</text>
				</view>

				<!-- 成功：七字段摘要 -->
				<view v-if="card != null" class="box box-ok">
					<text class="box-t">解析成功，确认一下</text>
					<view class="kv"><text class="kv-k">名字</text><text class="kv-v">{{ card!.name }}</text></view>
					<view class="kv"><text class="kv-k">身份</text><text class="kv-v">{{ card!.identity }}</text></view>
					<view class="kv"><text class="kv-k">外貌</text><text class="kv-v">{{ card!.appearance }}</text></view>
					<view class="kv"><text class="kv-k">性格</text><text class="kv-v">{{ card!.personality }}</text></view>
					<view class="kv"><text class="kv-k">说话</text><text class="kv-v">{{ card!.speaking_style }}</text></view>
					<view class="kv"><text class="kv-k">开场</text><text class="kv-v">{{ dialogText() }}</text></view>
					<view class="kv"><text class="kv-k">好感</text><text class="kv-v">{{ card!.initial_affection.toString() }}</text></view>
					<text v-for="(h, i) in hintList" :key="i" class="box-hint">· {{ h }}</text>
				</view>

				<!-- 可选附加段（常显：解析前也能先勾好） -->
				<view class="checks">
					<view class="checks-head">
						<text class="checks-t">附加规则</text>
						<text class="checks-n">{{ checksOn().toString() }} / 2</text>
					</view>
					<view class="checkcard" :style="ckNoAi ? 'border-color:#1C1A16;background-color:#EFE7D8' : 'border-color:#DCD4C4;background-color:#FBF7EE'"
						@click="toggleNoAi">
						<view class="check-l">
							<text class="check-title">去除 AI 味</text>
							<text class="check-desc">追加「禁止AI腔」：不总结升华、不列点给建议、不跳出角色评论对话。</text>
						</view>
						<view class="checkbox" :style="ckNoAi ? 'background-color:#1C1A16;border-color:#1C1A16' : 'background-color:transparent;border-color:#B9B1A0'">
							<text v-if="ckNoAi" class="checkmark">✓</text>
						</view>
					</view>
					<view class="checkcard" :style="ckSpeak ? 'border-color:#1C1A16;background-color:#EFE7D8' : 'border-color:#DCD4C4;background-color:#FBF7EE'"
						@click="toggleSpeak">
						<view class="check-l">
							<text class="check-title">说话方式</text>
							<text class="check-desc">口语化约束：句子长短不一、有情绪有立场、一句 1~50 字、少旁白。</text>
						</view>
						<view class="checkbox" :style="ckSpeak ? 'background-color:#1C1A16;border-color:#1C1A16' : 'background-color:transparent;border-color:#B9B1A0'">
							<text v-if="ckSpeak" class="checkmark">✓</text>
						</view>
					</view>
					<text class="checks-note">勾选的规则会追加到角色系统提示词末尾</text>
				</view>

				<view v-if="card != null" class="savebtn" @click="onSave">
					<text class="savebtn-t">存为角色卡并去检查</text>
				</view>

				<view class="pad"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script lang="uts">
	import { parseCardJson, mergeCardPromptFull, CardDraft, CardParseResult } from '../../utils/cardgen.uts'
	import { Character, InitDialog, newChar, upsertChar } from '../../utils/store.uts'

	export default {
		data() {
			return {
				headPad: 18,
				text: '',
				errText: '',
				errSnip: '',
				card: null as CardDraft | null,
				hintList: [] as Array<string>,
				ckNoAi: true,
				ckSpeak: true
			}
		},
		onLoad() {
			try {
				const info = uni.getWindowInfo()
				const sb = info.statusBarHeight
				if (sb > 0) {
					this.headPad = sb + 14
				}
			} catch (e) {
				// 默认值
			}
		},
		methods: {
			onInput(e: InputEvent): void {
				this.text = e.detail.value
				this.errText = ''
				this.errSnip = ''
				this.card = null
				this.hintList = [] as Array<string>
			},
			toggleNoAi(): void {
				this.ckNoAi = !this.ckNoAi
			},
			toggleSpeak(): void {
				this.ckSpeak = !this.ckSpeak
			},
			checksOn(): number {
				let n = 0
				if (this.ckNoAi) {
					n = n + 1
				}
				if (this.ckSpeak) {
					n = n + 1
				}
				return n
			},
			onParse(): void {
				if (this.text.trim().length == 0) {
					return
				}
				const r: CardParseResult = parseCardJson(this.text.trim())
				if (!r.ok) {
					this.card = null
					this.hintList = [] as Array<string>
					this.errText = '（' + r.stage + '）' + r.message
					this.errSnip = r.snippet
					return
				}
				this.errText = ''
				this.errSnip = ''
				this.card = r.card
				this.hintList = r.hints
			},
			dialogText(): string {
				if (this.card == null) {
					return ''
				}
				const ds = this.card!.init_dialog
				if (ds.length == 0) {
					return '（无）'
				}
				const d = ds[0]
				return '用户：' + d.user + ' / 角色：' + d.ai
			},
			onSave(): void {
				if (this.card == null) {
					return
				}
				const d = this.card!
				const c: Character = newChar()
				c.name = d.name
				c.prompt = mergeCardPromptFull(d, this.ckNoAi, this.ckSpeak)
				c.affinity = d.initial_affection
				const dialogs: Array<InitDialog> = []
				for (let i = 0; i < d.init_dialog.length; i++) {
					const dd = d.init_dialog[i]
					if (dd.user.length > 0) {
						dialogs.push({ role: 'user', text: dd.user } as InitDialog)
					}
					if (dd.ai.length > 0) {
						dialogs.push({ role: 'assistant', text: dd.ai } as InitDialog)
					}
				}
				c.dialogs = dialogs
				upsertChar(c)
				this.card = null
				this.hintList = [] as Array<string>
				this.errText = ''
				this.text = ''
				uni.showToast({ title: '已存卡，去检查一下吧', icon: 'none' })
				uni.navigateTo({
					url: '/pages/char/char?id=' + c.id
				})
			},
			onGoGen(): void {
				uni.navigateTo({
					url: '/pages/cardgen/cardgen'
				})
			},
			goBack(): void {
				uni.navigateBack()
			}
		}
	}
</script>

<style>
	.page {
		flex: 1;
		flex-direction: column;
		background-color: #F7F2E8;
	}

	.nav {
		flex-direction: row;
		align-items: flex-end;
		padding-left: 24px;
		padding-right: 24px;
		padding-bottom: 10px;
	}

