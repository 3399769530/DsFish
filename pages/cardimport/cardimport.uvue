		margin-top: 8px;
	}

	.box-hint {
		font-size: 11px;
		line-height: 17px;
		color: #B98A2E;
		margin-top: 4px;
	}

	.checks {
		margin-top: 20px;
	}

	.checks-head {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		border-bottom-width: 1px;
		border-color: #DCD4C4;
		padding-bottom: 8px;
	}

	.checks-t {
