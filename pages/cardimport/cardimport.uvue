		width: 34px;
		height: 30px;
		justify-content: flex-end;
		padding-bottom: 4px;
	}

	.back-t {
		font-size: 20px;
		color: #1C1A16;
	}

	.title {
		font-family: "Songti SC", "Noto Serif CJK SC", serif;
		font-size: 23px;
		font-weight: bold;
		letter-spacing: 1px;
		color: #1C1A16;
		margin-left: 6px;
	}

	.rule {
		height: 2px;
		background-color: #1C1A16;
		margin-left: 24px;
		margin-right: 24px;
	}

