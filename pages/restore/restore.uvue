<template>
	<view class="page">

		<view class="nav" :style="'padding-top:' + headPad + 'px'">
			<view class="back" @click="goBack">
				<text class="back-t">←</text>
			</view>
			<text class="title">粘贴备份</text>
		</view>
		<view class="rule"></view>

		<scroll-view class="body" scroll-y="true">
			<view class="wrap">
				<text class="hint">把之前「系统分享」出去或「复制」的备份内容，原样粘贴到下面，然后点导入。</text>

				<textarea class="area" :value="text" :maxlength="-1" placeholder="在这里长按 → 粘贴备份内容…"
					placeholder-style="color:#B9B1A0" @input="onInput"></textarea>

				<view class="meta-row">
					<text class="meta">{{ text.length }} 字符</text>
					<text v-if="text.length > 0" class="meta" :style="'color:' + stateColor">{{ stateText }}</text>
				</view>

				<view class="savebtn" :style="text.length == 0 ? 'background-color:#C9BFAC' : 'background-color:#1C1A16'" @click="onImport">
					<text class="savebtn-t">导入并覆盖</text>
				</view>

				<text class="note">导入会覆盖本机的角色卡、会话、消息和记忆；昵称、头像和接口配置保持不动。成功后自动返回。</text>
				<view class="pad"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script lang="uts">
	import { importAll, ImportResult } from '../../utils/store.uts'

	export default {
		data() {
			return {
				headPad: 18,
				text: '',
				stateText: '',
				stateColor: '#A9A292'
			}
		},
		onLoad() {
			try {
				const info = uni.getWindowInfo()
				const sb = info.statusBarHeight
				if (sb > 0) {
					this.headPad = sb + 14
				}
			} catch (e) {
				// 默认值
			}
		},
		methods: {
			onInput(e: InputEvent): void {
				this.text = e.detail.value
				this.stateText = ''
			},
			onImport(): void {
				if (this.text.trim().length == 0) {
					return
				}
				const r = importAll(this.text.trim())
				if (r.ok) {
					this.stateText = '导入成功'
					this.stateColor = '#2F5D50'
					uni.showToast({ title: '导入完成', icon: 'none' })
					setTimeout(() => {
						uni.navigateBack()
					}, 500)
					return
				}
				this.stateText = r.message
				this.stateColor = '#B4553C'
			},
			goBack(): void {
				uni.navigateBack()
			}
		}
	}
</script>

