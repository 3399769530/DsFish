		font-size: 20px;
		color: #1C1A16;
	}

	.title {
		font-family: "Songti SC", "Noto Serif CJK SC", serif;
		font-size: 23px;
		font-weight: bold;
		letter-spacing: 1px;
		color: #1C1A16;
		margin-left: 6px;
	}

	.rule {
		height: 2px;
		background-color: #1C1A16;
		margin-left: 24px;
		margin-right: 24px;
	}

	.body {
		flex: 1;
	}

	.wrap {
		padding-left: 24px;
		padding-right: 24px;
	}

	.hint {
		font-size: 12px;
		line-height: 19px;
		color: #8A8375;
		margin-top: 14px;
	}

	.area {
		width: 100%;
		height: 300px;
		margin-top: 12px;
		padding: 12px;
		background-color: #EFE7D8;
		border-radius: 4px;
		font-family: monospace;
		font-size: 12px;
		color: #1C1A16;
	}

	.meta-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-top: 8px;
	}

	.meta {
		font-size: 11.5px;
		color: #A9A292;
	}

	.savebtn {
		flex-direction: row;
		margin-top: 18px;
		padding-top: 14px;
		padding-bottom: 14px;
		border-radius: 3px;
		align-items: center;
		justify-content: center;
	}

	.savebtn-t {
		font-size: 13px;
		letter-spacing: 3px;
		color: #F7F2E8;
	}

	.note {
		font-size: 11px;
		line-height: 17px;
		color: #B9B1A0;
		margin-top: 14px;
	}

	.pad {
		height: 30px;
	}
</style>
