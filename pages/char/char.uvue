		width: 64px;
		height: 64px;
	}

	.hero-actions {
		flex-direction: row;
		align-items: center;
		margin-top: 8px;
	}

	.hero-link {
		font-size: 12px;
		color: #B4553C;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #B4553C;
		padding-bottom: 1px;
	}

	.hero-link-del {
		font-size: 12px;
		color: #A9A292;
		margin-left: 14px;
	}

	.hero-ava-t {
		font-family: "Songti SC", "Noto Serif CJK SC", serif;
		font-size: 22px;
		font-weight: bold;
		color: #1C1A16;
	}

	.hero-main {
		flex: 1;
		margin-left: 12px;
	}

	.hero-name-in {
		font-family: "Songti SC", "Noto Serif CJK SC", serif;
		font-size: 20px;
		font-weight: bold;
		color: #1C1A16;
		background-color: #00000000;
		border-width: 0;
		border-color: #00000000;
		padding: 0;
	}

	.hero-sub {
		font-size: 11.5px;
		color: #8A8375;
		margin-top: 4px;
	}

	/* 字段 */
	.aff-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.aff-input {
		width: 90px;
		text-align: right;
		font-family: monospace;
		font-size: 15px;
		color: #1C1A16;
	}
	.field {
		padding-top: 18px;
	}

	.label {
		font-size: 11px;
		letter-spacing: 2px;
		color: #8A8375;
		font-weight: bold;
	}

	.input {
		height: 38px;
		font-size: 15px;
		color: #1C1A16;
		margin-top: 4px;
	}

	.textarea {
		width: 100%;
		height: 150px;
		font-size: 14px;
		color: #1C1A16;
		margin-top: 6px;
		line-height: 22px;
	}

	.input-line {
		height: 1px;
		background-color: #DCD4C4;
	}

	.tip-row {
		flex-direction: row;
		align-items: center;
