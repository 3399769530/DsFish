		padding-top: 16px;
		padding-bottom: 16px;
	}

	.hero-ava {
		width: 64px;
		height: 64px;
		border-radius: 10px;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background-color: #EDE5D5;
	}

