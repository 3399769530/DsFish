		id: 'ch3',
		name: '翻译官',
		userName: '',
		prompt: '你是中英双语翻译官。用户给你中文，你给地道的英文；给英文，你给自然的中文。只给译文，必要时补一句用法说明。',
		dialogs: [
			{ role: 'assistant', text: '把要翻译的内容发给我就行。' } as InitDialog
		]
	},
	{
		id: 'ch4',
		name: '摸鱼助手',
		userName: '',
		prompt: '你是「摸鱼 Chat」的内置助手，负责介绍这个 App：怎么配置 API、怎么创建角色卡、数据存在哪里。语气轻松。',
		dialogs: [
			{ role: 'assistant', text: '嗨，我是摸鱼助手。想了解什么？' } as InitDialog
		]
	},
	{
		id: 'ch5',
		name: '猫娘小铃',
		userName: '铲屎官',
		prompt: '你是{{char}}，一只住在{{user}}家里的猫娘。说话黏人、尾音偶尔带「喵」但不要每句都带，爱吃、爱睡、有点傲娇；' +
			'被摸头会先炸毛再装作不在意。称呼{{user}}为「{{user}}」或「铲屎官」。' +
			'不用敬语，说话像熟人，句子短，偶尔撒娇但别油腻。',
		dialogs: [
			{ role: 'assistant', text: '……你终于回来了喵。' } as InitDialog,
			{ role: 'user', text: '路上堵车，你怎么还没睡' } as InitDialog,
			{ role: 'assistant', text: '谁、谁在等你啊。我只是刚好没困而已。' } as InitDialog
		]
	}
]

/**
 * 清掉旧的示例数据（角色卡 ch1~ch5 + 示例会话 demo1~3 及其消息）。
 * SHOW_DEMO 关掉后每次启动顺带跑一遍：没示例就是空转，用户自己的数据不受影响
 */
function purgeDemo(): void {
	const chars = loadChars()
	const keptChars: Array<Character> = []
	for (let i = 0; i < chars.length; i++) {
		if (!isDemoCharId(chars[i].id)) {
			keptChars.push(chars[i])
		}
	}
	if (keptChars.length != chars.length) {
		saveChars(keptChars)
	}

	const chats = loadChats()
	const keptChats: Array<Chat> = []
	let dropped = 0
	for (let i = 0; i < chats.length; i++) {
		const c = chats[i]
		const cid = c.id
		if (cid == 'demo1' || cid == 'demo2' || cid == 'demo3') {
			uni.removeStorageSync(KEY_MSG + cid)
			dropped++
			continue
		}
		keptChats.push(c)
	}
	if (dropped > 0) {
		saveChats(keptChats)
	}
}

export function seedDemo(): void {
	// 内置角色卡不受示例开关影响，缺了就补
	seedBuiltins()
	if (!SHOW_DEMO) {
		purgeDemo()
		return
	}
	if (loadChars().length == 0) {
		saveChars(DEMO_CHARS)
	} else {
		// 已经有数据了：把缺的示例角色补进去（不覆盖用户改过或删过的其他卡）
		const have = loadChars()
		let changed = false
		for (let i = 0; i < DEMO_CHARS.length; i++) {
			const d = DEMO_CHARS[i]
			let found = false
			for (let j = 0; j < have.length; j++) {
				if (have[j].id == d.id) {
					found = true
				}
			}
			if (!found) {
				have.push(d)
				changed = true
			}
		}
		if (changed) {
			saveChars(have)
		}
	}
	if (loadChats().length > 0) {
		return
	}
	const t = Date.now()
	const list: Array<Chat> = []

	const msgs1: Array<Msg> = [
		{ id: t - 3600000, text: '小王，今天的报表弄完了吗？', time: t - 3 * HOUR, mine: false } as Msg,
		{ id: t - 3500000, text: '快了老板，还差最后两页', time: t - 2 * HOUR - 50 * MIN, mine: true } as Msg,
		{ id: t - 3400000, text: '你倒是说句话啊，客户在催了', time: t - 2 * HOUR - 40 * MIN, mine: false } as Msg
	]
	saveMsgs('demo1', msgs1)
	list.push({
		id: 'demo1',
		charId: 'ch1',
		charName: '鱼老板',
		charEmoji: '🐟',
		lastText: '你倒是说句话啊，客户在催了',
		lastTime: t - 2 * HOUR - 40 * MIN
	} as Chat)

	const msgs2: Array<Msg> = [
		{ id: t - 2000000, text: '想写点什么？发给我一段文字，我帮你润色。', time: t - 26 * HOUR, mine: false } as Msg,
		{ id: t - 1900000, text: '帮我把「今天下雨了」改得有画面感一点', time: t - 25 * HOUR, mine: true } as Msg,
		{ id: t - 1800000, text: '窗外的雨把整条街泡软了，伞面敲出细碎的鼓点。', time: t - 24 * HOUR, mine: false } as Msg
	]
	saveMsgs('demo2', msgs2)
	list.push({
		id: 'demo2',
		charId: 'ch2',
		charName: '写作助手',
		charEmoji: '🐱',
		lastText: '窗外的雨把整条街泡软了，伞面敲出细碎的鼓点。',
		lastTime: t - 24 * HOUR
	} as Chat)

	const msgs3: Array<Msg> = [
		{ id: t - 800000, text: '把要翻译的内容发给我就行。', time: t - 3 * DAY, mine: false } as Msg,
		{ id: t - 700000, text: 'Bonjour, comment ça va ?', time: t - 3 * DAY + 20 * MIN, mine: true } as Msg,
		{ id: t - 600000, text: '你好，最近怎么样？', time: t - 3 * DAY + 21 * MIN, mine: false } as Msg
	]
	saveMsgs('demo3', msgs3)
	list.push({
		id: 'demo3',
		charId: 'ch3',
		charName: '翻译官',
		charEmoji: '🦊',
		lastText: '你好，最近怎么样？',
		lastTime: t - 3 * DAY + 21 * MIN
	} as Chat)

	saveChats(list)
}
