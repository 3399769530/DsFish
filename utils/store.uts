/** 内置卡的历史昵称：迁移比对用（用户自己起的名字不在其中，不会误伤） */
const BUILTIN_OLD_NAMES: UTSJSONObject = {
	cfish: ['大肥鱼', '大肥鱼-女儿版'],
	cmeow: ['铃喵'],
	cwhale: ['大肥鱼']
}

/** 内置卡种子：按 id 补缺；旧版内置卡（名字命中历史昵称）升级为新结构 */
function seedBuiltins(): void {
	const have = loadChars()
	let changed = false
	for (let i = 0; i < BUILTIN_CHARS.length; i++) {
		const d = BUILTIN_CHARS[i]
		let found = false
		for (let j = 0; j < have.length; j++) {
			if (have[j].id == d.id) {
				found = true
				const oldNames = BUILTIN_OLD_NAMES.getArray<string>(d.id)
				let isOld = false
				if (oldNames != null) {
					for (let k = 0; k < oldNames!.length; k++) {
						if (have[j].name == oldNames![k]) {
							isOld = true
						}
					}
				}
				if (isOld) {
					have[j].name = d.name
					have[j].label = d.label
					have[j].prompt = d.prompt
					changed = true
				}
				// 内置卡头像：没设过的补上（用户自己换过图就不动）
				const curAva = have[j].avatar
				if ((curAva == null || curAva!.length == 0) && d.avatar != null) {
					have[j].avatar = d.avatar
					changed = true
				}
			}
		}
		if (!found) {
			have.push(d)
			changed = true
		}
	}
	if (changed) {
		saveChars(have)
	}
}

/** 一条会话都没有时，用内置卡「小肥鱼」建一个默认会话（只在首页种子时调用，避免开聊时重复建） */
export function seedDefaultChat(): void {
	if (loadChats().length > 0) {
		return
	}
	const card = findChar('cfish')
	if (card != null) {
		createChatFor(card!)
	}
}

